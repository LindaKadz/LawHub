<div class="bg-white">
  <!-- Header -->
  <div class="relative bg-gray-800 pb-32">
    <div class="absolute inset-0">
      <img class="h-full w-full object-cover" src={Routes.static_path(@conn, "/images/khc.jpg")} alt="Judiciary"/>
      <div class="absolute inset-0 bg-gray-800 mix-blend-multiply" aria-hidden="true"></div>
    </div>
    <div class="relative mx-auto max-w-7xl px-6 py-24 sm:py-32 lg:px-8">
      <h1 class="text-4xl font-bold tracking-tight text-white md:text-5xl lg:text-6xl">About Us</h1>
      <p class="mt-6 max-w-3xl text-xl text-gray-300">
        Welcome, we are an online legal resource for legal assistance on affidavits, agreements,
        meeting legal counsel and commissioning of documents.
      </p>
    </div>
  </div>

  <!-- Overlapping cards -->
  <section class="relative z-10 mx-auto -mt-32 max-w-7xl px-6 pb-32 lg:px-8" aria-labelledby="contact-heading">
    <h2 class="sr-only" id="contact-heading">Contact us</h2>
    <div class="grid grid-cols-1 gap-y-20 lg:grid-cols-3 lg:gap-x-8 lg:gap-y-0">
      <div class="flex flex-col rounded-2xl bg-white shadow-xl">
        <div class="relative flex-1 px-6 pb-8 pt-16 md:px-8">
          <div class="absolute top-0 inline-block -translate-y-1/2 transform rounded-xl bg-indigo-600 p-5 shadow-lg">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456ZM16.894 20.567 16.5 21.75l-.394-1.183a2.25 2.25 0 0 0-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 0 0 1.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 0 0 1.423 1.423l1.183.394-1.183.394a2.25 2.25 0 0 0-1.423 1.423Z" />
          </svg>

          </div>
          <h3 class="text-xl font-medium text-gray-900">Transforming Legal Services</h3>
          <p class="mt-4 text-base text-gray-500">
            We are dedicated to giving you online legal services with a focus on convenience, proper draftsmanship,
            legality and promptness. Founded in 2019 Affidavits.co.ke intends to revolutionize law practice, ushering it into the digital age.
          </p>
        </div>
        <div class="rounded-bl-2xl rounded-br-2xl bg-gray-50 p-6 md:px-8">
          <a href="/contact" class="text-base font-medium text-indigo-700 hover:text-indigo-600">Contact us<span aria-hidden="true"> &rarr;</span></a>
        </div>
      </div>
      <div class="flex flex-col rounded-2xl bg-white shadow-xl">
        <div class="relative flex-1 px-6 pb-8 pt-16 md:px-8">
          <div class="absolute top-0 inline-block -translate-y-1/2 transform rounded-xl bg-indigo-600 p-5 shadow-lg">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon">
             <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
          </svg>
          </div>
          <h3 class="text-xl font-medium text-gray-900">We Are Experienced</h3>
          <p class="mt-4 text-base text-gray-500">
            The founder Brian Samuel Otieno, is an Advocate of the High court of Kenya. We have a team of advocates who
            have vast experience in the practice of law and providing well reasoned legal advice. We commit to excellence in service delivery.
          </p>
        </div>
        <div class="rounded-bl-2xl rounded-br-2xl bg-gray-50 p-6 md:px-8">
          <a href="/contact" class="text-base font-medium text-indigo-700 hover:text-indigo-600">Contact us<span aria-hidden="true"> &rarr;</span></a>
        </div>
      </div>
      <div class="flex flex-col rounded-2xl bg-white shadow-xl">
        <div class="relative flex-1 px-6 pb-8 pt-16 md:px-8">
          <div class="absolute top-0 inline-block -translate-y-1/2 transform rounded-xl bg-indigo-600 p-5 shadow-lg">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6.633 10.25c.806 0 1.533-.446 2.031-1.08a9.041 9.041 0 0 1 2.861-2.4c.723-.384 1.35-.956 1.653-1.715a4.498 4.498 0 0 0 .322-1.672V2.75a.75.75 0 0 1 .75-.75 2.25 2.25 0 0 1 2.25 2.25c0 1.152-.26 2.243-.723 3.218-.266.558.107 1.282.725 1.282m0 0h3.126c1.026 0 1.945.694 2.054 1.715.045.422.068.85.068 1.285a11.95 11.95 0 0 1-2.649 7.521c-.388.482-.987.729-1.605.729H13.48c-.483 0-.964-.078-1.423-.23l-3.114-1.04a4.501 4.501 0 0 0-1.423-.23H5.904m10.598-9.75H14.25M5.904 18.5c.083.205.173.405.27.602.197.4-.078.898-.523.898h-.908c-.889 0-1.713-.518-1.972-1.368a12 12 0 0 1-.521-3.507c0-1.553.295-3.036.831-4.398C3.387 9.953 4.167 9.5 5 9.5h1.053c.472 0 .745.556.5.96a8.958 8.958 0 0 0-1.302 4.665c0 1.194.232 2.333.654 3.375Z" />
          </svg>
          </div>
          <h3 class="text-xl font-medium text-gray-900">We Are Here For You</h3>
          <p class="mt-4 text-base text-gray-500">
            We hope you enjoy our products as much as we enjoy offering them to you using the latest information
            technology solutions that guarantee your security and privacy. If you have any questions or comments, please don't hesitate to contact us.
          </p>
        </div>
        <div class="rounded-bl-2xl rounded-br-2xl bg-gray-50 p-6 md:px-8">
          <a href="/contact" class="text-base font-medium text-indigo-700 hover:text-indigo-600">Contact us<span aria-hidden="true"> &rarr;</span></a>
        </div>
      </div>
    </div>
  </section>
</div>
